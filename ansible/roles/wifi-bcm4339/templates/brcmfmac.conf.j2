# Managed by Ansible (wifi-bcm4339 role)
{% if wifi_bcm4339_blacklist_bcmdhd | bool %}
# Prevent legacy out-of-tree bcmdhd driver from conflicting with brcmfmac on SDIO
blacklist bcmdhd
{% endif %}
{% if not (ansible_facts['kernel'] is match('^6\\.')) %}
# On i.MX7D kernel 5.x, enable the 32.768 kHz LPO reference clock (CCM_CLKO2)
# before loading brcmfmac so BCM4339 SDIO HT clock initializes without modifying
# the U-Boot Device Tree.
install brcmfmac /usr/local/sbin/brcm-clko2-enable.py && /sbin/modprobe --ignore-install brcmfmac $CMDLINE_OPTS
{% endif %}
{% if wifi_bcm4339_feature_disable | default('', true) | trim | length > 0 %}
# Disable BRCMF_FEAT_FWSUP (0x2000) and BRCMF_FEAT_SAE (0x80000) so wpa_supplicant
# handles WPA2-PSK / WPA3 handshakes in user space.
options brcmfmac feature_disable={{ wifi_bcm4339_feature_disable | trim }}
{% endif %}
