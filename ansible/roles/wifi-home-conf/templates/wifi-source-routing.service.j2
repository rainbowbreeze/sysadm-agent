[Unit]
Description=WiFi Source-Based Policy Routing Watcher ({{ wifi_home_conf_interface }})
After=network.target connman.service
Wants=connman.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/wifi-source-routing-watch.py --interface {{ wifi_home_conf_interface }} --script /usr/local/sbin/wifi-source-routing
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
