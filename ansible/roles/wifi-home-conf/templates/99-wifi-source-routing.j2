#!/usr/bin/env bash
# Managed by Ansible (wifi-home-conf role)
# Configures source-based policy routing on the WiFi interface so inbound
# connections to the WiFi IP always reply via the WiFi gateway even when eth0 is connected.
set -euo pipefail

WIFI_IFACE="{{ wifi_home_conf_interface }}"
ROUTE_TABLE="{{ wifi_home_conf_route_table }}"
RULE_PRIO="{{ wifi_home_conf_rule_priority }}"

IFACE="${1:-$WIFI_IFACE}"
ACTION="${2:-up}"

if [[ "$IFACE" != "$WIFI_IFACE" ]]; then
  exit 0
fi

case "$ACTION" in
  up|dhcp4-change|reapply)
    WIFI_CIDR="$(ip -4 addr show dev "$WIFI_IFACE" | awk '/inet / && /scope global/ {print $2; exit}')"
    WIFI_IP="${WIFI_CIDR%/*}"
    WIFI_SUBNET="$(ip -4 route show dev "$WIFI_IFACE" | awk '/^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+\/[0-9]+/ {print $1; exit}')"

    # 1. Prefer explicit default route on WIFI_IFACE in main table (NetworkManager)
    WIFI_GW="$(ip -4 route show default dev "$WIFI_IFACE" | awk '/ via / {for (i=1;i<=NF;i++) if ($i=="via") {print $(i+1); exit}}')"
    # 2. Fallback to ConnMan DHCP router /32 scope-link host route on WIFI_IFACE
    if [[ -z "$WIFI_GW" ]]; then
      WIFI_GW="$(ip -4 route show dev "$WIFI_IFACE" scope link | awk '$1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ {print $1; exit}')"
    fi
    # 3. Fallback to any other routing table carrying a default route for WIFI_IFACE
    if [[ -z "$WIFI_GW" ]]; then
      WIFI_GW="$(ip -4 route show table all default dev "$WIFI_IFACE" 2>/dev/null | awk -v tbl="$ROUTE_TABLE" '$0 !~ ("table " tbl " ") && / via / {for (i=1;i<=NF;i++) if ($i=="via") {print $(i+1); exit}}')"
    fi

    if [[ -n "$WIFI_IP" && -n "$WIFI_GW" ]]; then
      # Ensure loose reverse-path filtering (2) so cross-subnet packets arriving on WIFI_IFACE
      # are not dropped when eth0 holds the primary default route in the main table.
      sysctl -qw "net.ipv4.conf.all.rp_filter=2" "net.ipv4.conf.${WIFI_IFACE}.rp_filter=2" 2>/dev/null || true

      ip route flush table "$ROUTE_TABLE" 2>/dev/null || true
      if [[ -n "$WIFI_SUBNET" ]]; then
        ip route replace "$WIFI_SUBNET" dev "$WIFI_IFACE" scope link src "$WIFI_IP" table "$ROUTE_TABLE"
      fi
      ip route replace default via "$WIFI_GW" dev "$WIFI_IFACE" src "$WIFI_IP" table "$ROUTE_TABLE"

      while ip rule del priority "$RULE_PRIO" 2>/dev/null; do :; done
      ip rule add from "${WIFI_IP}/32" lookup "$ROUTE_TABLE" priority "$RULE_PRIO"
    fi
    ;;
  down)
    while ip rule del priority "$RULE_PRIO" 2>/dev/null; do :; done
    ip route flush table "$ROUTE_TABLE" 2>/dev/null || true
    ;;
esac
