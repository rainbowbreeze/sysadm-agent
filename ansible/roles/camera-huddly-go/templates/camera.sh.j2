#!/usr/bin/env bash
# ==============================================================================
# File: {{ camera_huddly_go_install_dir }}/camera.sh
# Symlinked Location: {{ camera_huddly_go_cli_path }}
# Description: Top-level CLI wrapper for the Huddly GO USB Camera module.
#
# Supported Commands:
#   camera status             Display USB/UVC hardware status, PTZ, and V4L2 info
#   camera status --json      Output status as JSON
#   camera capture [file]     Capture snapshot JPEG (default: /tmp/camera_snapshot_<ts>.jpg)
#   camera snapshot [file]    Alias for capture
#   camera ptz [options]      Get or set digital Pan/Tilt/Zoom and image controls
#   camera detect             Quick diagnostic probe of USB and V4L2 camera hardware
# ==============================================================================
set -euo pipefail

PROJECT_DIR="{{ camera_huddly_go_install_dir }}"
VENV_ACTIVATE="{{ camera_huddly_go_python_venv }}/bin/activate"
PYTHON_SCRIPT="${PROJECT_DIR}/camera.py"

if [[ ! -f "${PYTHON_SCRIPT}" ]]; then
    printf '[ERROR] Missing %s\n' "${PYTHON_SCRIPT}" >&2
    exit 1
fi

if [[ -f "${VENV_ACTIVATE}" ]]; then
    # shellcheck disable=SC1090
    source "${VENV_ACTIVATE}"
fi

export CAMERA_VIDEO_DEV="${CAMERA_VIDEO_DEV:-{{ camera_huddly_go_video_device }}}"
export CAMERA_USB_VID="${CAMERA_USB_VID:-{{ camera_huddly_go_usb_vendor_id }}}"
export CAMERA_USB_PID="${CAMERA_USB_PID:-{{ camera_huddly_go_usb_product_id }}}"
export CAMERA_DEFAULT_WIDTH="${CAMERA_DEFAULT_WIDTH:-{{ camera_huddly_go_default_width }}}"
export CAMERA_DEFAULT_HEIGHT="${CAMERA_DEFAULT_HEIGHT:-{{ camera_huddly_go_default_height }}}"
export CAMERA_DEFAULT_ROTATE="${CAMERA_DEFAULT_ROTATE:-{{ camera_huddly_go_default_rotate }}}"
export CAMERA_DEFAULT_WARMUP="${CAMERA_DEFAULT_WARMUP:-{{ camera_huddly_go_default_warmup }}}"
export CAMERA_DEFAULT_ZOOM="${CAMERA_DEFAULT_ZOOM:-{{ camera_huddly_go_default_zoom }}}"
export CAMERA_DEFAULT_PAN="${CAMERA_DEFAULT_PAN:-{{ camera_huddly_go_default_pan }}}"
export CAMERA_DEFAULT_TILT="${CAMERA_DEFAULT_TILT:-{{ camera_huddly_go_default_tilt }}}"

exec python3 "${PYTHON_SCRIPT}" "$@"
