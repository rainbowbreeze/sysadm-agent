#!/usr/bin/env python3
import datetime
import glob
import os

os.environ.setdefault("XDG_RUNTIME_DIR", "{{ camerabooth_xdg_runtime_dir }}")
os.environ.setdefault("WAYLAND_DISPLAY", "{{ camerabooth_wayland_display }}")
os.environ.setdefault("GDK_BACKEND", "{{ camerabooth_gdk_backend }}")

import subprocess
import threading
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import GLib, GdkPixbuf, Gtk

BOOTH_DIR = os.path.expanduser("{{ camerabooth_output_dir }}")
CAMERA_CLI = "{{ camerabooth_camera_cli }}"
CAMERA_ROTATION = "{{ camerabooth_rotation }}"
PREVIEW_W, PREVIEW_H = {{ camerabooth_preview_width }}, {{ camerabooth_preview_height }}


class CameraBoothApp(Gtk.Window):
    def __init__(self):
        super().__init__(title="{{ camerabooth_window_title }}")
        self.set_default_size({{ camerabooth_window_width }}, {{ camerabooth_window_height }})
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(10)
        self.connect("destroy", Gtk.main_quit)

        os.makedirs(BOOTH_DIR, exist_ok=True)

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.add(vbox)

        self.image = Gtk.Image()
        self.image.set_size_request(PREVIEW_W, PREVIEW_H)
        vbox.pack_start(self.image, True, True, 0)

        self.status_label = Gtk.Label(label=f"Folder: {BOOTH_DIR}")
        vbox.pack_start(self.status_label, False, False, 0)

        self.button = Gtk.Button(label="Take Picture")
        self.button.set_size_request(-1, {{ camerabooth_button_height }})
        self.button.connect("clicked", self.on_take_picture)
        vbox.pack_start(self.button, False, False, 0)

        latest = sorted(glob.glob(os.path.join(BOOTH_DIR, "*.jpg")))
        if latest:
            self.show_photo(latest[-1], f"Latest: {os.path.basename(latest[-1])}")

    def show_photo(self, path, msg):
        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, PREVIEW_W, PREVIEW_H, True)
            self.image.set_from_pixbuf(pixbuf)
            self.status_label.set_text(msg)
        except Exception as exc:
            self.status_label.set_text(f"Error loading image: {exc}")

    def on_take_picture(self, _btn):
        self.button.set_sensitive(False)
        self.button.set_label("Capturing picture...")
        self.status_label.set_text("Warming up sensor and capturing photo...")
        threading.Thread(target=self._capture_worker, daemon=True).start()

    def _capture_worker(self):
        ts = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        out_path = os.path.join(BOOTH_DIR, f"photo_{ts}.jpg")
        cmd = [CAMERA_CLI, "capture", out_path]
        if CAMERA_ROTATION != "":
            cmd.extend(["--rotation", str(CAMERA_ROTATION)])
        res = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
        GLib.idle_add(
            self._on_capture_done,
            res.returncode == 0 and os.path.isfile(out_path),
            out_path,
            res.stderr,
        )

    def _on_capture_done(self, ok, out_path, err_msg):
        self.button.set_sensitive(True)
        self.button.set_label("Take Picture")
        if ok:
            self.show_photo(out_path, f"Saved: {out_path}")
        else:
            self.status_label.set_text(f"Capture failed: {err_msg.strip() or 'Unknown error'}")
        return False


if __name__ == "__main__":
    win = CameraBoothApp()
    win.show_all()
    Gtk.main()
