#!/usr/bin/env python3
"""
Touchscreen GTK 3 + GStreamer Photobooth Application (/usr/local/bin/camera-booth)
Features:
  - Live low-FPS camera preview stream matching final photo framing, color, and rotation
  - High-contrast animated visual countdown overlay (e.g., 3 -> 2 -> 1 -> shutter flash)
  - Zero-shutter-lag capture at countdown = 0 from the already-converged sensor stream
    (with automatic CLI fallback if GStreamer live streaming is unavailable)
  - Post-capture photo review with automatic return to live viewfinder
"""

import datetime
import glob
import math
import os
import re
import subprocess
import sys
import threading
import time

os.environ.setdefault("XDG_RUNTIME_DIR", "{{ camerabooth_xdg_runtime_dir }}")
os.environ.setdefault("WAYLAND_DISPLAY", "{{ camerabooth_wayland_display }}")
os.environ.setdefault("GDK_BACKEND", "{{ camerabooth_gdk_backend }}")

import cairo  # noqa: E402
import gi  # noqa: E402

gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gdk, GdkPixbuf, Gtk  # noqa: E402

try:
    gi.require_version("Gst", "1.0")
    from gi.repository import Gst

    Gst.init(None)
    GST_AVAILABLE = True
except Exception:
    Gst = None
    GST_AVAILABLE = False

BOOTH_DIR = os.path.expanduser("{{ camerabooth_output_dir }}")
CAMERA_CLI = "{{ camerabooth_camera_cli }}"
CAMERA_ROTATION_OVERRIDE = "{{ camerabooth_rotation }}"
COUNTDOWN_SECONDS = max(0, int({{ camerabooth_countdown_seconds | int }}))
PREVIEW_ENABLED = {{ "True" if (camerabooth_preview_enabled | bool) else "False" }}
PREVIEW_FPS = max(1, min(15, int({{ camerabooth_preview_fps | int }})))
REVIEW_SECONDS = max(1, int({{ camerabooth_review_seconds | int }}))
WIN_W, WIN_H = {{ camerabooth_window_width }}, {{ camerabooth_window_height }}
PREVIEW_W, PREVIEW_H = {{ camerabooth_preview_width }}, {{ camerabooth_preview_height }}
BUTTON_H = {{ camerabooth_button_height }}

STATE_LIVE = "live"
STATE_COUNTDOWN = "countdown"
STATE_CAPTURING = "capturing"
STATE_REVIEW = "review"


def _load_camera_config():
    """Read camera defaults from /opt/camera/camera.sh (if deployed by camera-ov5645)."""
    cfg = {
        "device": "/dev/video1",
        "width": 1280,
        "height": 960,
        "rotate": 180,
        "quality": 95,
        "native_1080p": False,
    }
    candidates = []
    if os.path.islink(CAMERA_CLI):
        candidates.append(os.path.realpath(CAMERA_CLI))
    candidates.extend([CAMERA_CLI, "/opt/camera/camera.sh"])
    for path in candidates:
        if os.path.isfile(path):
            try:
                txt = open(path, "r", encoding="utf-8", errors="ignore").read()
                vals = {}
                for m in re.finditer(r"export\s+(CAMERA_[A-Z0-9_]+)=.*:-([^}\"\s]+)\}+\"", txt):
                    vals[m.group(1)] = m.group(2)
                if "CAMERA_VIDEO_DEV" in vals:
                    cfg["device"] = vals["CAMERA_VIDEO_DEV"]
                if "CAMERA_DEFAULT_WIDTH" in vals and vals["CAMERA_DEFAULT_WIDTH"].isdigit():
                    cfg["width"] = int(vals["CAMERA_DEFAULT_WIDTH"])
                if "CAMERA_DEFAULT_HEIGHT" in vals and vals["CAMERA_DEFAULT_HEIGHT"].isdigit():
                    cfg["height"] = int(vals["CAMERA_DEFAULT_HEIGHT"])
                for rk in ("CAMERA_ROTATION", "CAMERA_DEFAULT_ROTATE"):
                    if rk in vals and vals[rk].isdigit():
                        cfg["rotate"] = int(vals[rk])
                        break
                if "CAMERA_DEFAULT_QUALITY" in vals and vals["CAMERA_DEFAULT_QUALITY"].isdigit():
                    cfg["quality"] = int(vals["CAMERA_DEFAULT_QUALITY"])
                if "CAMERA_NATIVE_1080P" in vals:
                    cfg["native_1080p"] = vals["CAMERA_NATIVE_1080P"].lower() in ("1", "true", "yes")
                break
            except Exception:
                pass

    if CAMERA_ROTATION_OVERRIDE != "":
        try:
            cfg["rotate"] = int(CAMERA_ROTATION_OVERRIDE)
        except ValueError:
            pass

    # Ensure 24MHz CLKO1 MCLK is enabled when /opt/camera/camera.py is available
    if os.path.isfile("/opt/camera/camera.py"):
        try:
            sys.path.insert(0, "/opt/camera")
            import camera as cam_mod  # type: ignore

            cam_mod.enable_clko1()
        except Exception:
            pass

    return cfg


def _uses_mainline_ov5645():
    link = "/sys/bus/i2c/devices/3-003c/driver"
    if os.path.islink(link):
        try:
            return os.path.basename(os.readlink(link)) == "ov5645"
        except OSError:
            return False
    return False


def _flip_element(rotate):
    if rotate == 180:
        return "! videoflip video-direction=180 "
    if rotate == 90:
        return "! videoflip video-direction=90r "
    if rotate == 270:
        return "! videoflip video-direction=90l "
    return ""


class CameraBoothApp(Gtk.Window):
    def __init__(self):
        super().__init__(title="{{ camerabooth_window_title }}")
        self.set_default_size(WIN_W, WIN_H)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_border_width(8)
        self.connect("destroy", self.on_destroy)

        os.makedirs(BOOTH_DIR, exist_ok=True)
        self.cam_cfg = _load_camera_config()

        self.state = STATE_LIVE
        self.pipeline = None
        self.prev_sink = None
        self.snap_sink = None
        self.stream_active = False
        self._ui_frame_pending = False

        self.live_pixbuf = None
        self.review_pixbuf = None
        self.countdown_end = 0.0
        self.countdown_total = float(COUNTDOWN_SECONDS)
        self.countdown_timer_id = None
        self.flash_alpha = 0.0
        self.flash_timer_id = None
        self.review_end = 0.0
        self.review_timer_id = None

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.add(vbox)

        self.canvas = Gtk.DrawingArea()
        self.canvas.set_size_request(PREVIEW_W, PREVIEW_H)
        self.canvas.connect("draw", self.on_draw_canvas)
        vbox.pack_start(self.canvas, True, True, 0)

        self.status_label = Gtk.Label(label="Initializing camera preview...")
        self.status_label.set_ellipsize(3)  # PANGO_ELLIPSIZE_END
        vbox.pack_start(self.status_label, False, False, 0)

        self.button = Gtk.Button(label=self._take_button_label())
        self.button.set_size_request(-1, BUTTON_H)
        self.button.connect("clicked", self.on_button_clicked)
        vbox.pack_start(self.button, False, False, 0)

        latest = sorted(glob.glob(os.path.join(BOOTH_DIR, "*.jpg")))
        if latest:
            try:
                self.review_pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                    latest[-1], PREVIEW_W, PREVIEW_H, True
                )
            except Exception:
                self.review_pixbuf = None

        if PREVIEW_ENABLED and GST_AVAILABLE and os.path.exists(self.cam_cfg["device"]):
            GLib.idle_add(self.start_stream)
        else:
            self.state = STATE_REVIEW if self.review_pixbuf else STATE_LIVE
            self.status_label.set_text(f"Ready — photos saved to {BOOTH_DIR}")

    def _take_button_label(self):
        if COUNTDOWN_SECONDS > 0:
            return f"Take Picture ({COUNTDOWN_SECONDS}s Timer)"
        return "Take Picture"

    def _build_pipeline_str(self):
        dev = self.cam_cfg["device"]
        w, h = self.cam_cfg["width"], self.cam_cfg["height"]
        rot = self.cam_cfg["rotate"]

        use_5mp_1080p = (
            (w, h) == (1920, 1080)
            and not self.cam_cfg["native_1080p"]
            and _uses_mainline_ov5645()
        )
        if use_5mp_1080p:
            sensor_w, sensor_h = 2592, 1944
            raw_w, raw_h = 2592, 1458
            crop_str = "! videocrop top=242 bottom=244 "
            fps = min(PREVIEW_FPS, 4)
        else:
            sensor_w, sensor_h = w, h
            raw_w, raw_h = w, h
            crop_str = ""
            fps = PREVIEW_FPS

        # Compute pre-rotation scale dimensions (multiples of 4 for exact RGB rowstride)
        if rot in (90, 270):
            fit = min(PREVIEW_W / float(raw_h), PREVIEW_H / float(raw_w))
        else:
            fit = min(PREVIEW_W / float(raw_w), PREVIEW_H / float(raw_h))
        scale_w = max(64, int(raw_w * fit) & ~3)
        scale_h = max(64, int(raw_h * fit) & ~3)
        flip_str = _flip_element(rot)

        return (
            f"v4l2src device={dev} "
            f"! video/x-raw,format=UYVY,width={sensor_w},height={sensor_h} "
            f"! videorate drop-only=true max-rate={fps} "
            f"{crop_str}"
            f"! tee name=t "
            f"t. ! queue max-size-buffers=1 leaky=downstream "
            f"! videoscale method=0 "
            f"! video/x-raw,format=UYVY,width={scale_w},height={scale_h} "
            f"! videoconvert {flip_str}"
            f"! video/x-raw,format=RGB "
            f"! appsink name=prev_sink emit-signals=true max-buffers=1 drop=true sync=false "
            f"t. ! queue max-size-buffers=1 leaky=downstream "
            f"! fakesink name=snap_sink enable-last-sample=true sync=false"
        )

    def start_stream(self):
        if self.pipeline is not None or not (PREVIEW_ENABLED and GST_AVAILABLE):
            return False
        try:
            pipe_str = self._build_pipeline_str()
            self.pipeline = Gst.parse_launch(pipe_str)
            self.prev_sink = self.pipeline.get_by_name("prev_sink")
            self.snap_sink = self.pipeline.get_by_name("snap_sink")
            self.prev_sink.connect("new-sample", self.on_new_preview_sample)

            bus = self.pipeline.get_bus()
            bus.add_signal_watch()
            bus.connect("message::error", self.on_gst_error)

            ret = self.pipeline.set_state(Gst.State.PLAYING)
            if ret == Gst.StateChangeReturn.FAILURE:
                raise RuntimeError("Failed to set GStreamer pipeline to PLAYING")

            self.stream_active = True
            if self.state != STATE_REVIEW:
                self.state = STATE_LIVE
                self.status_label.set_text(
                    f"Live preview ({self.cam_cfg['width']}x{self.cam_cfg['height']}, {PREVIEW_FPS} fps) — tap button to take photo"
                )
        except Exception as exc:
            self.stop_stream()
            self.status_label.set_text(f"Live stream unavailable ({exc}); CLI capture ready")
        return False

    def stop_stream(self):
        self.stream_active = False
        if self.pipeline is not None:
            try:
                bus = self.pipeline.get_bus()
                if bus is not None:
                    bus.remove_signal_watch()
                self.pipeline.set_state(Gst.State.NULL)
            except Exception:
                pass
            self.pipeline = None
            self.prev_sink = None
            self.snap_sink = None

    def on_gst_error(self, _bus, msg):
        err, _dbg = msg.parse_error()
        self.stop_stream()
        self.status_label.set_text(f"Stream stopped ({err.message}) — CLI capture ready")
        self.canvas.queue_draw()

    def on_new_preview_sample(self, sink):
        sample = sink.emit("pull-sample")
        if sample is None or self._ui_frame_pending:
            return Gst.FlowReturn.OK
        caps = sample.get_caps()
        if caps is None or caps.get_size() == 0:
            return Gst.FlowReturn.OK
        st = caps.get_structure(0)
        ok_w, pw = st.get_int("width")
        ok_h, ph = st.get_int("height")
        if not (ok_w and ok_h and pw > 0 and ph > 0):
            return Gst.FlowReturn.OK

        buf = sample.get_buffer()
        ok_map, mapinfo = buf.map(Gst.MapFlags.READ)
        if not ok_map:
            return Gst.FlowReturn.OK
        try:
            raw_bytes = bytes(mapinfo.data)
        finally:
            buf.unmap(mapinfo)

        rowstride = max(pw * 3, len(raw_bytes) // ph)
        self._ui_frame_pending = True
        GLib.idle_add(self._update_live_pixbuf, raw_bytes, pw, ph, rowstride)
        return Gst.FlowReturn.OK

    def _update_live_pixbuf(self, raw_bytes, pw, ph, rowstride):
        self._ui_frame_pending = False
        try:
            gbytes = GLib.Bytes.new(raw_bytes)
            self.live_pixbuf = GdkPixbuf.Pixbuf.new_from_bytes(
                gbytes, GdkPixbuf.Colorspace.RGB, False, 8, pw, ph, rowstride
            )
            if self.state in (STATE_LIVE, STATE_COUNTDOWN) or self.flash_alpha > 0.0:
                self.canvas.queue_draw()
        except Exception:
            pass
        return False

    def on_button_clicked(self, _btn):
        if self.state == STATE_REVIEW:
            self._finish_review_to_live()
            return
        if self.state != STATE_LIVE:
            return

        if COUNTDOWN_SECONDS <= 0:
            self._trigger_shutter()
            return

        self.state = STATE_COUNTDOWN
        self.countdown_total = float(COUNTDOWN_SECONDS)
        self.countdown_end = time.monotonic() + self.countdown_total
        self.button.set_sensitive(False)
        self._update_countdown_ui()
        self.countdown_timer_id = GLib.timeout_add(50, self._on_countdown_tick)

    def _on_countdown_tick(self):
        remaining = self.countdown_end - time.monotonic()
        if remaining <= 0.0:
            self.countdown_timer_id = None
            self._trigger_shutter()
            return False
        self._update_countdown_ui(remaining)
        return True

    def _update_countdown_ui(self, remaining=None):
        if remaining is None:
            remaining = max(0.0, self.countdown_end - time.monotonic())
        secs_ceil = max(1, int(math.ceil(remaining)))
        prompt = "Smile!" if secs_ceil == 1 else "Get ready..."
        self.button.set_label(f"{prompt} {secs_ceil}")
        self.status_label.set_text(f"{prompt} Taking picture in {secs_ceil}...")
        self.canvas.queue_draw()

    def _trigger_shutter(self):
        self.state = STATE_CAPTURING
        self.button.set_sensitive(False)
        self.button.set_label("Capturing! 📸")
        self.status_label.set_text("Capturing photo right now...")

        # Grab exact t=0 sample from live stream before encoding in background
        captured_sample = None
        if self.stream_active and self.snap_sink is not None:
            try:
                captured_sample = self.snap_sink.get_property("last-sample")
            except Exception:
                captured_sample = None

        # Trigger immediate visual shutter flash so subject sees exact capture instant
        self.flash_alpha = 0.9
        self.canvas.queue_draw()
        if self.flash_timer_id is not None:
            GLib.source_remove(self.flash_timer_id)
        self.flash_timer_id = GLib.timeout_add(35, self._on_flash_tick)

        threading.Thread(
            target=self._capture_worker, args=(captured_sample,), daemon=True
        ).start()

    def _on_flash_tick(self):
        self.flash_alpha = max(0.0, self.flash_alpha - 0.18)
        self.canvas.queue_draw()
        if self.flash_alpha <= 0.01:
            self.flash_alpha = 0.0
            self.flash_timer_id = None
            return False
        return True

    def _encode_sample_to_jpeg(self, sample, out_path):
        w, h = self.cam_cfg["width"], self.cam_cfg["height"]
        rot = self.cam_cfg["rotate"]
        qual = self.cam_cfg["quality"]
        flip_str = _flip_element(rot)

        st = sample.get_caps().get_structure(0)
        _, sw = st.get_int("width")
        _, sh = st.get_int("height")
        scale_str = ""
        if (sw, sh) != (w, h):
            scale_str = f"! videoscale ! video/x-raw,width={w},height={h} "

        enc_pipe = Gst.parse_launch(
            f"appsrc name=src format=time is-live=false "
            f"! videoconvert {scale_str}{flip_str}"
            f"! jpegenc quality={qual} "
            f"! appsink name=out sync=false"
        )
        try:
            src_el = enc_pipe.get_by_name("src")
            out_el = enc_pipe.get_by_name("out")
            src_el.set_property("caps", sample.get_caps())
            enc_pipe.set_state(Gst.State.PLAYING)
            src_el.emit("push-buffer", sample.get_buffer())
            src_el.emit("end-of-stream")
            jpg_sample = out_el.emit("try-pull-sample", 5 * Gst.SECOND)
            if jpg_sample is None:
                return False, "JPEG encoder timed out"
            jbuf = jpg_sample.get_buffer()
            ok_map, mapinfo = jbuf.map(Gst.MapFlags.READ)
            if not ok_map:
                return False, "Failed to map JPEG buffer"
            try:
                with open(out_path, "wb") as f:
                    f.write(mapinfo.data)
            finally:
                jbuf.unmap(mapinfo)
            return os.path.isfile(out_path) and os.path.getsize(out_path) > 0, ""
        finally:
            enc_pipe.set_state(Gst.State.NULL)

    def _capture_worker(self, captured_sample):
        ts = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        out_path = os.path.join(BOOTH_DIR, f"photo_{ts}.jpg")

        if captured_sample is not None and GST_AVAILABLE:
            try:
                ok, err = self._encode_sample_to_jpeg(captured_sample, out_path)
                GLib.idle_add(self._on_capture_done, ok, out_path, err)
                return
            except Exception as exc:
                err_fallback = str(exc)
            else:
                err_fallback = ""
        else:
            err_fallback = ""

        # Fallback: stop stream if holding /dev/video1, run CLI capture, then restart stream
        GLib.idle_add(self.stop_stream)
        time.sleep(0.15)
        cmd = [CAMERA_CLI, "capture", out_path]
        if CAMERA_ROTATION_OVERRIDE != "":
            cmd.extend(["--rotation", str(CAMERA_ROTATION_OVERRIDE)])
        res = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
        ok = res.returncode == 0 and os.path.isfile(out_path)
        GLib.idle_add(
            self._on_capture_done,
            ok,
            out_path,
            res.stderr or err_fallback,
        )
        if PREVIEW_ENABLED and GST_AVAILABLE:
            GLib.timeout_add(300, self.start_stream)

    def _on_capture_done(self, ok, out_path, err_msg):
        if ok:
            try:
                self.review_pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(
                    out_path, PREVIEW_W, PREVIEW_H, True
                )
            except Exception as exc:
                self.status_label.set_text(f"Saved {out_path}, preview error: {exc}")
                self._finish_review_to_live()
                return False

            self.state = STATE_REVIEW
            self.review_end = time.monotonic() + float(REVIEW_SECONDS)
            self.status_label.set_text(f"Saved: {out_path}")
            self.button.set_sensitive(True)
            self._update_review_button()
            self.canvas.queue_draw()
            if self.review_timer_id is not None:
                GLib.source_remove(self.review_timer_id)
            self.review_timer_id = GLib.timeout_add(250, self._on_review_tick)
        else:
            self.state = STATE_LIVE
            self.button.set_sensitive(True)
            self.button.set_label(self._take_button_label())
            self.status_label.set_text(
                f"Capture failed: {(err_msg or '').strip() or 'Unknown error'}"
            )
            self.canvas.queue_draw()
        return False

    def _on_review_tick(self):
        if self.state != STATE_REVIEW:
            self.review_timer_id = None
            return False
        rem = self.review_end - time.monotonic()
        if rem <= 0.0:
            self.review_timer_id = None
            self._finish_review_to_live()
            return False
        self._update_review_button(rem)
        return True

    def _update_review_button(self, remaining=None):
        if remaining is None:
            remaining = max(0.0, self.review_end - time.monotonic())
        secs = max(1, int(math.ceil(remaining)))
        if self.stream_active:
            self.button.set_label(f"Back to Live Camera ({secs}s)")
        else:
            self.button.set_label(self._take_button_label())

    def _finish_review_to_live(self):
        if self.review_timer_id is not None:
            GLib.source_remove(self.review_timer_id)
            self.review_timer_id = None
        self.state = STATE_LIVE
        self.button.set_sensitive(True)
        self.button.set_label(self._take_button_label())
        if self.stream_active:
            self.status_label.set_text(
                f"Live preview ({self.cam_cfg['width']}x{self.cam_cfg['height']}, {PREVIEW_FPS} fps) — tap button to take photo"
            )
        else:
            self.status_label.set_text(f"Ready — photos saved to {BOOTH_DIR}")
        self.canvas.queue_draw()

    def on_draw_canvas(self, widget, cr):
        alloc = widget.get_allocation()
        cw, ch = alloc.width, alloc.height

        # Dark studio backdrop
        cr.set_source_rgb(0.08, 0.09, 0.11)
        cr.rectangle(0, 0, cw, ch)
        cr.fill()

        # Choose active pixbuf
        pixbuf = None
        if self.state == STATE_REVIEW and self.review_pixbuf is not None:
            pixbuf = self.review_pixbuf
        elif self.live_pixbuf is not None:
            pixbuf = self.live_pixbuf
        elif self.review_pixbuf is not None:
            pixbuf = self.review_pixbuf

        if pixbuf is not None:
            pw, ph = pixbuf.get_width(), pixbuf.get_height()
            scale = min(cw / float(pw), ch / float(ph))
            dw, dh = pw * scale, ph * scale
            dx, dy = (cw - dw) / 2.0, (ch - dh) / 2.0
            cr.save()
            cr.translate(dx, dy)
            cr.scale(scale, scale)
            Gdk.cairo_set_source_pixbuf(cr, pixbuf, 0, 0)
            cr.paint()
            cr.restore()
        else:
            cr.set_source_rgb(0.65, 0.68, 0.72)
            cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
            cr.set_font_size(18)
            msg = "Starting live camera stream..." if PREVIEW_ENABLED else "Ready to take picture"
            ext = cr.text_extents(msg)
            cr.move_to((cw - ext.width) / 2.0, (ch + ext.height) / 2.0)
            cr.show_text(msg)

        # Top-left status badge (LIVE or SAVED)
        if self.state == STATE_REVIEW and self.review_pixbuf is not None:
            self._draw_badge(cr, 12, 12, "PHOTO SAVED", (0.15, 0.62, 0.95))
        elif self.stream_active and self.live_pixbuf is not None:
            self._draw_badge(cr, 12, 12, "LIVE", (0.18, 0.82, 0.38))

        # Centered visual countdown overlay
        if self.state == STATE_COUNTDOWN:
            remaining = max(0.0, self.countdown_end - time.monotonic())
            secs_num = max(1, int(math.ceil(remaining)))
            frac = min(1.0, max(0.0, remaining / max(0.1, self.countdown_total)))
            cx, cy = cw / 2.0, ch / 2.0
            radius = min(cw, ch) * 0.24

            # Translucent dark circle
            cr.set_source_rgba(0.06, 0.07, 0.09, 0.72)
            cr.arc(cx, cy, radius, 0, 2.0 * math.pi)
            cr.fill()

            # Subtle background track ring
            cr.set_line_width(7.0)
            cr.set_source_rgba(1.0, 1.0, 1.0, 0.22)
            cr.arc(cx, cy, radius - 5.0, 0, 2.0 * math.pi)
            cr.stroke()

            # Sweeping countdown progress arc (green -> warm gold on '1')
            if secs_num == 1:
                cr.set_source_rgba(1.0, 0.82, 0.18, 0.96)
            else:
                cr.set_source_rgba(0.25, 0.85, 0.98, 0.96)
            start_ang = -math.pi / 2.0
            end_ang = start_ang + 2.0 * math.pi * frac
            cr.arc(cx, cy, radius - 5.0, start_ang, end_ang)
            cr.stroke()

            # Large crisp countdown digit
            digit_str = str(secs_num)
            cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
            cr.set_font_size(radius * 1.15)
            ext = cr.text_extents(digit_str)
            tx = cx - (ext.width / 2.0 + ext.x_bearing)
            ty = cy - (ext.height / 2.0 + ext.y_bearing)
            cr.set_source_rgba(1.0, 1.0, 1.0, 0.98)
            cr.move_to(tx, ty)
            cr.show_text(digit_str)

        # White camera shutter flash at exact capture instant (t = 0)
        if self.flash_alpha > 0.0:
            cr.set_source_rgba(1.0, 1.0, 1.0, self.flash_alpha)
            cr.rectangle(0, 0, cw, ch)
            cr.fill()

        return False

    @staticmethod
    def _draw_badge(cr, x, y, text, dot_rgb):
        cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        cr.set_font_size(12)
        ext = cr.text_extents(text)
        pad_x, pad_y = 10, 6
        bw = ext.width + pad_x * 2 + 14
        bh = max(22, ext.height + pad_y * 2)

        cr.set_source_rgba(0.06, 0.07, 0.09, 0.72)
        cr.rectangle(x, y, bw, bh)
        cr.fill()

        cr.set_source_rgb(*dot_rgb)
        cr.arc(x + 11, y + bh / 2.0, 4.2, 0, 2.0 * math.pi)
        cr.fill()

        cr.set_source_rgba(1.0, 1.0, 1.0, 0.95)
        cr.move_to(x + 21, y + (bh - ext.height) / 2.0 - ext.y_bearing)
        cr.show_text(text)

    def on_destroy(self, *_args):
        for tid in (self.countdown_timer_id, self.flash_timer_id, self.review_timer_id):
            if tid is not None:
                GLib.source_remove(tid)
        self.stop_stream()
        Gtk.main_quit()


if __name__ == "__main__":
    win = CameraBoothApp()
    win.show_all()
    Gtk.main()
