CAMERA_USTREAMER_DEVICE="{{ stream_ustreamer_video_device }}"
CAMERA_USTREAMER_FORMAT="{{ stream_ustreamer_format }}"
CAMERA_USTREAMER_WIDTH="{{ stream_ustreamer_width }}"
CAMERA_USTREAMER_HEIGHT="{{ stream_ustreamer_height }}"
CAMERA_USTREAMER_HOST="{{ stream_ustreamer_host }}"
CAMERA_USTREAMER_PORT="{{ stream_ustreamer_port }}"
